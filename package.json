{
	"name": "obsidian-s3-publisher",
	"version": "1.6.7",
	"description": "Publish notes to S3/MinIO",
	"author": "Marco Laux",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
